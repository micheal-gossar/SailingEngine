{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Oblong Sailing Game",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\build.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run Oblong Sailing Game",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-Command",
                "Start-Process -FilePath '${workspaceFolder}\\build\\oblong_sailing_game.exe' -WorkingDirectory '${workspaceFolder}'"
            ],
            "dependsOrder": "sequence",
            "dependsOn": "Build Oblong Sailing Game",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ]
}
