{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Oblong Sailing Game (Debug)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\build.ps1",
                "-Configuration",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "label": "Build Oblong Sailing Game (Release)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\build.ps1",
                "-Configuration",
                "Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "label": "Build Oblong Sailing Game (Performance)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\build.ps1",
                "-Configuration",
                "Performance"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "label": "Build and Run Oblong Sailing Game (Debug)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-Command",
                "Start-Process -FilePath '${workspaceFolder}\\build\\Debug\\oblong_sailing_game.exe' -WorkingDirectory '${workspaceFolder}'"
            ],
            "dependsOrder": "sequence",
            "dependsOn": "Build Oblong Sailing Game (Debug)",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "Build and Run Oblong Sailing Game (Release)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-Command",
                "Start-Process -FilePath '${workspaceFolder}\\build\\Release\\oblong_sailing_game.exe' -WorkingDirectory '${workspaceFolder}'"
            ],
            "dependsOrder": "sequence",
            "dependsOn": "Build Oblong Sailing Game (Release)",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "Build and Run Oblong Sailing Game (Performance)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-Command",
                "Start-Process -FilePath '${workspaceFolder}\\build\\Performance\\oblong_sailing_game.exe' -WorkingDirectory '${workspaceFolder}'"
            ],
            "dependsOrder": "sequence",
            "dependsOn": "Build Oblong Sailing Game (Performance)",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "Clean Build Directory (Debug)",
            "type": "process",
            "command": "C:\\Program Files\\CMake\\bin\\cmake.exe",
            "args": [
                "-E",
                "remove_directory",
                "${workspaceFolder}\\build\\Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "Clean Build Directory (Release)",
            "type": "process",
            "command": "C:\\Program Files\\CMake\\bin\\cmake.exe",
            "args": [
                "-E",
                "remove_directory",
                "${workspaceFolder}\\build\\Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "Clean Build Directory (Performance)",
            "type": "process",
            "command": "C:\\Program Files\\CMake\\bin\\cmake.exe",
            "args": [
                "-E",
                "remove_directory",
                "${workspaceFolder}\\build\\Performance"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "build"
        }
    ]
}
